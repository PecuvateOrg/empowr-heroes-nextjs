# Empowr Heroes — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local to git.
# All of these must also be set in Netlify > Site configuration > Environment variables.

# ------------------------------------------------------------------
# Stripe
# ------------------------------------------------------------------

# Your Stripe secret key (starts with sk_live_ or sk_test_)
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Your Stripe webhook signing secret (starts with whsec_)
# Found at: https://dashboard.stripe.com/webhooks — after creating the webhook endpoint
# For local testing with Stripe CLI, use the secret the CLI prints on startup
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------
# Resend (email sending)
# ------------------------------------------------------------------

# Your Resend API key
# Found at: https://resend.com/api-keys
RESEND_API_KEY=re_...

# ------------------------------------------------------------------
# Notion (donation logging)
# ------------------------------------------------------------------

# Your Notion integration token (starts with secret_)
# Found at: https://www.notion.so/my-integrations — after creating an integration
NOTION_API_KEY=secret_...

# The ID of your Notion donations database
# Found in the database URL: notion.so/YOUR-WORKSPACE/THIS-PART-IS-THE-ID?v=...
NOTION_DATABASE_ID=...

# ------------------------------------------------------------------
# Site
# ------------------------------------------------------------------

# The live URL of the deployed site — used to build badge image URLs in emails
# No trailing slash
SITE_URL=https://heroes.empowr-cic.org
